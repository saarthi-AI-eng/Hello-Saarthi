# Saarthi Backend - copy to .env and fill in values

# Server (frontend expects http://localhost:8000/api)
PORT=8000
HOST=0.0.0.0

# AI service (backend_api_docs.md)
AI_SERVICE_BASE_URL=https://api.saarthi.app/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saarthi

# JWT (use strong secret in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── AI Part B (all optional; defaults shown) ─────────────────────────────────
# Tiered models. Tier 1 = small/local (defaults to OPENAI_BASE_URL/CHAT_MODEL above).
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_CHAT_MODEL=llama3.2:1b
# Tier 2 = full/cloud model for complex questions; unset = everything stays on Tier 1.
# CLOUD_BASE_URL=https://openrouter.ai/api/v1
# CLOUD_API_KEY=sk-or-v1-...
# CLOUD_CHAT_MODEL=z-ai/glm-5.2:free
# DAILY_CLOUD_TOKEN_BUDGET=0            # 0 = no daily cap on Tier 2 tokens
# CLOUD_BUDGET_FLAG_FILE=               # JSON from Product: {"remaining_tokens": N} or {"exhausted": true}
# CLASSIFIER_MODE=heuristic             # or "llm"
# ROUTER_MAX_TOKENS=400
# Semantic cache (Tier 0)
# SEMANTIC_CACHE=1
# SEMANTIC_CACHE_THRESHOLD=0.95
# SEMANTIC_CACHE_TTL_DAYS=30
# Socratic default: hints first, full solution after N hints
# SOCRATIC_MAX_HINTS=3
# Skip the faithfulness critic (one LLM call) on slow CPU demos
# FAST_CHAT=0
# Retrieval legs (ColBERT / cross-encoder need GPU packages; they skip if missing)
# RETRIEVAL_COLBERT=0
# COLBERT_MODEL=colbert-ir/colbertv2.0
# RETRIEVAL_RERANK=0
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_EXPAND=0                    # add up to 2 neighbouring chunks
# Weak-topic boost from quiz attempts / topic mastery
# WEAK_TOPIC_BOOST=1
# WEAK_TOPIC_THRESHOLD=0.6
# Traces for the researcher dashboard (knowledge_base/traces/*.jsonl)
# TRACES=1
# TRACE_QUERY_TEXT=1
# ── AI WBS v2 (grounding rule, classifier, caps) ─────────────────────────────
# ALLOW_WEB_AGENT=0                     # grounding rule: no open-web answers in student chat
# TOP_N_TIER1=3                         # chunks in the prompt for Tier 1 (spec 4.2)
# TOP_N_TIER2=8                         # chunks in the prompt for Tier 2
# STUDENT_DAILY_TOKENS=20000            # over this, a student is kept on Tier 1 (spec 4.6)
# INSTRUCTOR_DAILY_TOKENS=50000
# PER_USER_CAPS=1
# MCQ_MODEL=                            # stronger model for MCQ writing on the Tier 1 endpoint (1B is not enough)
# RETRIEVAL_LEGS=dense,bm25             # eval/ablation only
